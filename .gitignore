# Never commit runtime outputs, models or datasets
__pycache__/
*.py[cod]
*.pt
*.pth
*.ckpt
*.jit
*.onnx
*.engine
*.npy
*.npz
*.jpg
*.jpeg
*.png
*.tiff
*.tif
*.webp
*.mp4
*.avi
*.mov
*.zip
*.tar
*.cache
*.csv
*.json
*.jsonl
*.log
*.pkl
*.pickle
runs/
results/
outputs/
checkpoints/
datasets/
.venv/
venv/
.env
.env.*
*.key
*.pem
.DS_Store

# Exception: original EfficientAD teacher checkpoint
!checkpoints/teacher/
!checkpoints/teacher/best_teacher.pth

# Allow only the original EfficientAD teacher checkpoint
!checkpoints/
checkpoints/*
!checkpoints/teacher/
checkpoints/teacher/*
!checkpoints/teacher/best_teacher.pth
